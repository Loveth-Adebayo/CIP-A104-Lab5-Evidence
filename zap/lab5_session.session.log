/*C5*/INSERT INTO ALERT VALUES(29,0,10111,'Authentication Request Identified',0,1,'The given request has been identified as an authentication request. The ''Other Info'' field contains a set of key=value lines which identify any relevant fields. If the request is in a context which has an Authentication Method set to "Auto-Detect" then this rule will change the authentication to match the request identified.','http://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details','user-info-php-submit-button','userParam=user-info-php-submit-button\u000auserValue=View Account Details\u000apasswordParam=password\u000areferer=http://192.168.56.107:8081/index.php?page=user-info.php','This is an informational alert rather than a vulnerability and so there is nothing to fix.','https://www.zaproxy.org/docs/desktop/addons/authentication-helper/auth-req-id/',10,10,'','password',-1,-1,3,'','http://192.168.56.107:8081/index.php (page,password,user-info-php-submit-button,username)','10111')
