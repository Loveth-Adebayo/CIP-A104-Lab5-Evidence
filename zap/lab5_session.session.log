/*C5*/INSERT INTO ALERT VALUES(21,0,10041,'HTTP to HTTPS Insecure Transition in Form Post',2,2,'This check looks for insecure HTTP pages that host HTTPS forms. The issue is that an insecure HTTP page can easily be hijacked through MITM and the secure HTTPS form can be replaced or spoofed.','http://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details','','The response to the following request over HTTP included an HTTPS form tag action attribute value:\u000a\u000ahttp://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details\u000aThe context was:\u000a\u000a<form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank">\u000d\u000a\u0009\u0009\u0009\u0009\u0009<input type="hidden" name="cmd" value="_s-xclick">\u000d\u000a\u0009\u0009\u0009\u0009\u0009<input type="hidden" name="hosted_button_id" value="45R3YEXENU97S">\u000d\u000a\u0009\u0009\u0009\u0009\u0009<input type="image" src="https://www.paypalobjects.com/en_US/i/btn/btn_donate_LG.gif" name="submit" alt="Donate Today!">\u000d\u000a\u0009\u0009\u0009\u0009\u0009<img alt="" src="https://www.paypalobjects.com/en_US/i/scr/pixel.gif" width="1" height="1">\u000d\u000a\u0009\u0009\u0009\u0009</form>','Use HTTPS for landing pages that host secure forms.','',10,10,'','https://www.paypal.com/cgi-bin/webscr',319,15,3,'','http://192.168.56.107:8081/index.php (page,password,user-info-php-submit-button,username)','10041')
COMMIT
