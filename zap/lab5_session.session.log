/*C5*/INSERT INTO ALERT VALUES(25,0,10031,'User Controllable HTML Element Attribute (Potential XSS)',0,1,'This check looks at user-supplied input in query string parameters and POST data to identify where certain HTML attribute values might be controlled. This provides hot-spot detection for XSS (cross-site scripting) that will require further review by a security analyst to determine exploitability.','http://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details','page','User-controlled HTML attribute values were found. Try injecting special characters to see if XSS might be possible. The page at the following URL:\u000a\u000ahttp://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details\u000a\u000aappears to include user input in:\u000aa(n) [input] tag [value] attribute\u000a\u000aThe user input found was:\u000apage=user-info.php\u000a\u000aThe user-controlled value was:\u000auser-info.php','Validate all input and sanitize output it before writing to any HTML attributes.','https://cheatsheetseries.owasp.org/cheatsheets/Input_Validation_Cheat_Sheet.html',10,10,'','',20,20,3,'','http://192.168.56.107:8081/index.php (page,password,user-info-php-submit-button,username)','10031')
COMMIT
