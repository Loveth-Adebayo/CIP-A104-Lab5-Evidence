/*C5*/INSERT INTO ALERT VALUES(78,0,10036,'Server Leaks Version Information via "Server" HTTP Response Header Field',1,3,'The web/application server is leaking version information via the "Server" HTTP response header. Access to such information may facilitate attackers identifying other vulnerabilities your web/application server is subject to.','http://192.168.56.107/dvwa/vulnerabilities/xss_s/','','','Ensure that your web server, application server, load balancer, etc. is configured to suppress the "Server" header or provide generic details.','https://httpd.apache.org/docs/current/mod/core.html#servertokens\u000ahttps://learn.microsoft.com/en-us/previous-versions/msp-n-p/ff648552(v=pandp.10)\u000ahttps://www.troyhunt.com/shhh-dont-let-your-response-headers/',29,29,'','Apache/2.4.52 (Ubuntu)',497,13,3,'','http://192.168.56.107/dvwa/vulnerabilities/xss_s/','10036-2')
COMMIT
