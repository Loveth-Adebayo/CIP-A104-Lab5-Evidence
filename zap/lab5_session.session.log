/*C5*/INSERT INTO ALERT VALUES(37,0,10010,'Cookie No HttpOnly Flag',1,2,'A cookie has been set without the HttpOnly flag, which means that the cookie can be accessed by JavaScript. If a malicious script can be run on this page then the cookie will be accessible and can be transmitted to another site. If this is a session cookie then session hijacking may be possible.','http://192.168.56.107/dvwa/login.php','PHPSESSID','','Ensure that the HttpOnly flag is set for all cookies.','https://owasp.org/www-community/HttpOnly',18,18,'','Set-Cookie: PHPSESSID',1004,13,3,'','http://192.168.56.107/dvwa/login.php ()(Login,password,user_token,username)','10010')
COMMIT
