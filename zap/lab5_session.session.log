/*C5*/INSERT INTO ALERT VALUES(38,0,10054,'Cookie without SameSite Attribute',1,2,'A cookie has been set without the SameSite attribute, which means that the cookie can be sent as a result of a ''cross-site'' request. The SameSite attribute is an effective counter measure to cross-site request forgery, cross-site script inclusion, and timing attacks.','http://192.168.56.107/dvwa/login.php','PHPSESSID','','Ensure that the SameSite attribute is set to either ''lax'' or ideally ''strict'' for all cookies.','https://datatracker.ietf.org/doc/html/draft-ietf-httpbis-cookie-same-site',18,18,'','Set-Cookie: PHPSESSID',1275,13,3,'','http://192.168.56.107/dvwa/login.php ()(Login,password,user_token,username)','10054-1')
COMMIT
