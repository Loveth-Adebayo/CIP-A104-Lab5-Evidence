/*C5*/INSERT INTO ALERT VALUES(44,0,10112,'Session Management Response Identified',0,2,'The given response has been identified as containing a session management token. The ''Other Info'' field contains a set of header tokens that can be used in the Header Based Session Management Method. If the request is in a context which has a Session Management Method set to "Auto-Detect" then this rule will change the session management to use the tokens identified.','http://192.168.56.107/dvwa/login.php','PHPSESSID','cookie:PHPSESSID','This is an informational alert rather than a vulnerability and so there is nothing to fix.','https://www.zaproxy.org/docs/desktop/addons/authentication-helper/session-mgmt-id/',18,18,'','PHPSESSID',-1,-1,3,'','http://192.168.56.107/dvwa/login.php ()(Login,password,user_token,username)','10112')
COMMIT
