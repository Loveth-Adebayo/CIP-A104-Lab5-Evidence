/*C5*/INSERT INTO ALERT VALUES(23,0,10036,'Server Leaks Version Information via "Server" HTTP Response Header Field',1,3,'The web/application server is leaking version information via the "Server" HTTP response header. Access to such information may facilitate attackers identifying other vulnerabilities your web/application server is subject to.','http://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details','','','Ensure that your web server, application server, load balancer, etc. is configured to suppress the "Server" header or provide generic details.','https://httpd.apache.org/docs/current/mod/core.html#servertokens\u000ahttps://learn.microsoft.com/en-us/previous-versions/msp-n-p/ff648552(v=pandp.10)\u000ahttps://www.troyhunt.com/shhh-dont-let-your-response-headers/',10,10,'','Apache/2.4.68 (Debian)',497,13,3,'','http://192.168.56.107:8081/index.php (page,password,user-info-php-submit-button,username)','10036-2')
