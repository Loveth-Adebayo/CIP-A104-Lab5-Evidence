/*C5*/INSERT INTO ALERT VALUES(22,0,10109,'Modern Web Application',0,2,'The application appears to be a modern web application. If you need to explore it automatically then the Client Spider may well be more effective than the standard one.','http://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details','','Links have been found that do not have traditional href attributes, which is an indication that this is a modern web application.','This is an informational alert and so no changes are required.','',10,10,'','<a href="">OWASP 2017</a>',-1,-1,3,'','http://192.168.56.107:8081/index.php (page,password,user-info-php-submit-button,username)','10109')
