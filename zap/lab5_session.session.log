/*C5*/INSERT INTO ALERT VALUES(3,0,10027,'Information Disclosure - Suspicious Comments',0,2,'The response appears to contain suspicious comments which may help an attacker.','http://192.168.56.107:8081/index.php?page=user-info.php','','The following pattern was used: \bUSER\b and was detected in likely comment: "<!-- I think the database password is set to blank or perhaps samurai.\u000a\u0009\u0009\u0009It depends on whether you installed this web app from ", see evidence field for the suspicious comment/snippet.','Remove all comments that return information that may help an attacker and fix any underlying problems they refer to.','',1,1,'','comments because no user will ever see\u000a\u0009\u0009\u0009th',615,13,3,'','http://192.168.56.107:8081/index.php (page)','10027')
COMMIT
