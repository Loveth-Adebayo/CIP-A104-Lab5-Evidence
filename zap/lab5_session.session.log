/*C5*/INSERT INTO ALERT VALUES(54,0,10109,'Modern Web Application',0,2,'The application appears to be a modern web application. If you need to explore it automatically then the Client Spider may well be more effective than the standard one.','http://192.168.56.107/dvwa/vulnerabilities/fi/?page=file1.php','','Links have been found that do not have traditional href attributes, which is an indication that this is a modern web application.','This is an informational alert and so no changes are required.','',21,21,'','<a href="#" onclick="javascript:toggleTheme();" class="theme-icon" title="Toggle theme between light and dark.">\u000a                    <img src="../../dvwa/images/theme-light-dark.png" alt="Damn Vulnerable Web Application" />\u000a                </a>',-1,-1,3,'','http://192.168.56.107/dvwa/vulnerabilities/fi/ (page)','10109')
COMMIT
