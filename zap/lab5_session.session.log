/*C5*/INSERT INTO ALERT VALUES(10,0,10037,'Server Leaks Information via "X-Powered-By" HTTP Response Header Field(s)',1,2,'The web/application server is leaking information via one or more "X-Powered-By" HTTP response headers. Access to such information may facilitate attackers identifying other frameworks/components your web application is reliant upon and the vulnerabilities such components may be subject to.','http://192.168.56.107:8081/index.php?page=user-info.php','','','Ensure that your web server, application server, load balancer, etc. is configured to suppress "X-Powered-By" headers.','https://owasp.org/www-project-web-security-testing-guide/v42/4-Web_Application_Security_Testing/01-Information_Gathering/08-Fingerprint_Web_Application_Framework\u000ahttps://www.troyhunt.com/shhh-dont-let-your-response-headers/',1,1,'','X-Powered-By: PHP/8.5.9',497,13,3,'','http://192.168.56.107:8081/index.php (page)','10037')
