/*C5*/INSERT INTO ALERT VALUES(24,0,90003,'Sub Resource Integrity Attribute Missing',2,3,'The integrity attribute is missing on a script or link tag served by an external server. The integrity tag prevents an attacker who have gained access to this server from injecting a malicious content.','http://192.168.56.107:8081/index.php?page=user-info.php&username=admin%27+OR+%271%27%3D%271%27+%23&password=anything&user-info-php-submit-button=View+Account+Details','','','Provide a valid integrity attribute to the tag.','https://developer.mozilla.org/en-US/docs/Web/Security/Defenses/Subresource_Integrity',10,10,'','<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">',345,15,3,'','http://192.168.56.107:8081/index.php (page,password,user-info-php-submit-button,username)','90003')
